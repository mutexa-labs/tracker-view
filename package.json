{
  "name": "@mutexa/tracker-view",
  "version": "0.1.2",
  "description": "See any Hyperliquid address the way public trackers see it: positions sorted by closest liquidation, flags above your alert threshold, a re-plan of each position into a band of slices, and a read-only watch mode.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutexa-labs/tracker-view.git"
  },
  "homepage": "https://github.com/mutexa-labs/tracker-view#readme",
  "bugs": {
    "url": "https://github.com/mutexa-labs/tracker-view/issues"
  },
  "keywords": [
    "hyperliquid",
    "liquidation",
    "tracker",
    "exposure",
    "cli",
    "privacy",
    "mutexa"
  ],
  "bin": {
    "tracker-view": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"{src,test,scripts,examples}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts,examples}/**/*.ts\"",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "record": "tsx scripts/record.ts"
  },
  "dependencies": {
    "@mutexa/ladder": "github:mutexa-labs/liquidation-ladder#v0.1.0",
    "@mutexa/liq-math": "github:mutexa-labs/liq-math#v0.1.0",
    "@mutexa/venue-adapters": "github:mutexa-labs/venue-adapters#v0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
